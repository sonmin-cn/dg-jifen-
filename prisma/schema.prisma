generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  LEADER_MANAGER
  PRODUCT_MANAGER
  FINANCE
  ADMIN
  LEADER
  EXECUTIVE_VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LeaderStatus {
  INTERN
  REGULAR
  LEFT
  SUSPENDED
}

enum ScoreYearStatus {
  NOT_STARTED
  ACTIVE
  SEALED
  SETTLED
}

enum TripStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum TripLeaderRole {
  MAIN
  ASSISTANT
  OTHER
}

enum ScoreDirection {
  ADD
  DEDUCT
}

enum ScoreCategory {
  BASE_TRIP
  HOLIDAY
  SOCIAL
  REPURCHASE
  REFERRAL
  MENTORSHIP
  MATERIAL
  VIOLATION
  COMPLAINT
  SAFETY
  REDLINE
  MANUAL
}

enum ScoreRecordStatus {
  EFFECTIVE
  VOIDED
}

enum ScoreSourceType {
  TRIP_LEADER
  APPLICATION
  HOLIDAY_ATTENDANCE
  VIOLATION_EVENT
  MANUAL
}

enum ScoreRuleReviewType {
  AUTO
  MANUAL_REVIEW
  MANUAL_RECORD
}

enum ScoreRuleTriggerType {
  TRIP_COMPLETED
  SCORE_APPLICATION_APPROVED
  HOLIDAY_ATTENDANCE_APPROVED
  VIOLATION_CONFIRMED
  MANUAL
}

enum ScoreApplicationType {
  MOMENTS_POST
  XHS_POST
  WECHAT_MOMENTS
  XIAOHONGSHU
  REPURCHASE
  MENTORSHIP
}

enum ScoreApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NEEDS_MORE_INFO
}

enum EvidenceRelatedType {
  SCORE_APPLICATION
  SCORE_RECORD
  SOCIAL_POST
  REPURCHASE_CLAIM
  HOLIDAY_ATTENDANCE
  VIOLATION_EVENT
}

enum SocialPlatform {
  WECHAT_MOMENTS
  XIAOHONGSHU
}

enum SocialPostStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum RepurchaseClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CONFLICTED
  VOIDED
}

enum HolidayType {
  MAY_DAY
  NATIONAL_DAY
}

enum BonusSettlementStatus {
  DRAFT
  CONFIRMED
  LOCKED
}

enum ViolationType {
  GENERAL
  COMPLAINT
  SAFETY
  REDLINE
  FAKE_BEHAVIOR
}

enum ViolationSeverity {
  MINOR
  NORMAL
  SERIOUS
  CRITICAL
}

enum ViolationStatus {
  DRAFT
  PENDING_REVIEW
  EFFECTIVE
  REVOKED
}

enum LeaderBindRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  name               String
  phone              String              @unique
  email              String?
  passwordHash       String
  role               UserRole
  status             UserStatus          @default(ACTIVE)
  authProvider       String?
  miniProgramOpenId  String?
  miniProgramUnionId String?
  miniProgramUserId  String?
  lastLoginSource    String?
  leader             Leader?
  leaderBindRequests LeaderBindRequest[]
  auditLogs          AuditLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([role, status])
}

model Leader {
  id                   String                @id @default(cuid())
  userId               String?               @unique
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalLeaderId     String?               @unique
  miniProgramLeaderId  String?
  miniProgramPhone     String?
  realName             String
  nickname             String?
  phone                String                @unique
  region               String?
  residentLocation     String?
  status               LeaderStatus          @default(REGULAR)
  level                String?
  rawLeaderIdentity    String?
  rawLeaderLevel       String?
  rawJobStatus         String?
  leadCount            Int?
  leadDays             Float?
  auditTime            DateTime?
  frozenTime           DateTime?
  jobStatus            String?
  lastImportedAt       DateTime?
  sourceSystem         String?
  joinDate             DateTime?
  recommenderLeaderId  String?
  recommenderLeader    Leader?               @relation("LeaderRecommendations", fields: [recommenderLeaderId], references: [id], onDelete: SetNull)
  recommendedLeaders   Leader[]              @relation("LeaderRecommendations")
  tags                 String?               @db.Text
  remark               String?               @db.Text
  tripLeaders          TripLeader[]
  scoreApplications    ScoreApplication[]
  scoreRecords         ScoreRecord[]
  socialPosts          SocialPost[]
  repurchaseClaims     RepurchaseClaim[]
  holidayAttendances   HolidayAttendance[]
  bonusSettlements     BonusSettlement[]
  bonusSettlementItems BonusSettlementItem[]
  violationEvents      ViolationEvent[]
  bindRequests         LeaderBindRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status, region])
  @@index([jobStatus])
  @@index([sourceSystem])
}

model LeaderBindRequest {
  id            String                  @id @default(cuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaderId      String
  leader        Leader                  @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  userPhone     String
  leaderPhone   String
  realNameInput String
  status        LeaderBindRequestStatus @default(PENDING)
  matchScore    Float?
  matchReason   String?                 @db.Text
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectReason  String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([leaderId, status])
}

model ScoreYear {
  id                 String              @id @default(cuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  sealDate           DateTime?
  status             ScoreYearStatus
  remark             String?             @db.Text
  scoreApplications  ScoreApplication[]
  scoreRecords       ScoreRecord[]
  holidayAttendances HolidayAttendance[]
  violationEvents    ViolationEvent[]
  bonusPools         BonusPool[]
  bonusSettlements   BonusSettlement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, startDate, endDate])
}

model ScoreRule {
  id                String               @id @default(cuid())
  code              String
  name              String
  version           Int                  @default(1)
  category          ScoreCategory
  direction         ScoreDirection
  points            Float
  reviewType        ScoreRuleReviewType
  triggerType       ScoreRuleTriggerType
  isActive          Boolean              @default(true)
  effectiveFrom     DateTime             @default(now())
  effectiveTo       DateTime?
  description       String?              @db.Text
  configJson        String?              @db.Text
  scoreRecords      ScoreRecord[]
  scoreApplications ScoreApplication[]
  violationEvents   ViolationEvent[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([code, version])
  @@index([code, isActive, effectiveFrom, effectiveTo])
  @@index([category, direction])
}

model Trip {
  id                String             @id @default(cuid())
  routeName         String
  region            String?
  startDate         DateTime
  endDate           DateTime
  tripDays          Float
  status            TripStatus         @default(PLANNED)
  participantCount  Int?
  productManagerId  String?
  isHoliday         Boolean            @default(false)
  tripLeaders       TripLeader[]
  scoreApplications ScoreApplication[]
  scoreRecords      ScoreRecord[]
  socialPosts       SocialPost[]
  repurchaseClaims  RepurchaseClaim[]
  violationEvents   ViolationEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, startDate])
  @@index([region])
}

model TripLeader {
  id                   String         @id @default(cuid())
  tripId               String
  trip                 Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  leaderId             String
  leader               Leader         @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  role                 TripLeaderRole @default(MAIN)
  actualWorkDays       Float
  isCompleted          Boolean        @default(false)
  baseScoreGeneratedAt DateTime?
  baseScoreRecordId    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([tripId, leaderId])
  @@index([leaderId, isCompleted])
}

model ScoreApplication {
  id              String                 @id @default(cuid())
  scoreYearId     String
  scoreYear       ScoreYear              @relation(fields: [scoreYearId], references: [id], onDelete: Restrict)
  leaderId        String
  leader          Leader                 @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  tripId          String?
  trip            Trip?                  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  ruleId          String?
  rule            ScoreRule?             @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleCode        String?
  type            ScoreApplicationType
  title           String                 @default("")
  description     String?                @db.Text
  evidenceText    String?                @db.Text
  evidenceUrl     String?                @db.Text
  evidenceJson    String?                @db.Text
  // oneOrderOneLeader 规则（复购）的归一化订单号；approvedOrderKey 仅审核通过时写入，
  // 唯一约束保证同一订单全局只能审核通过一次
  orderNo          String?
  approvedOrderKey String?               @unique
  requestedPoints Float
  approvedPoints  Float?
  status          ScoreApplicationStatus @default(PENDING)
  payloadJson     String?                @db.Text
  submittedAt     DateTime               @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectReason    String?                @db.Text
  remark          String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  scoreRecord     ScoreRecord?
  socialPost      SocialPost?
  repurchaseClaim RepurchaseClaim?

  @@index([scoreYearId, status, type])
  @@index([leaderId, submittedAt])
  @@index([ruleId])
  @@index([ruleCode])
  @@index([orderNo])
}

model ScoreRecord {
  id               String            @id @default(cuid())
  scoreYearId      String
  scoreYear        ScoreYear         @relation(fields: [scoreYearId], references: [id], onDelete: Restrict)
  leaderId         String
  leader           Leader            @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  tripId           String?
  trip             Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  applicationId    String?           @unique
  application      ScoreApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  violationEventId String?
  violationEvent   ViolationEvent?   @relation(fields: [violationEventId], references: [id], onDelete: SetNull)
  ruleId           String?
  rule             ScoreRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleCode         String?
  ruleName         String?
  ruleVersion      Int?
  rulePoints       Float?
  ruleSnapshotJson String?           @db.Text
  sourceType       ScoreSourceType
  sourceId         String
  category         ScoreCategory
  item             String
  direction        ScoreDirection
  rawPoints        Float
  effectivePoints  Float
  status           ScoreRecordStatus @default(EFFECTIVE)
  occurredAt       DateTime
  approvedBy       String?
  approvedAt       DateTime?
  remark           String?           @db.Text
  voidReason       String?           @db.Text
  voidedBy         String?
  voidedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([scoreYearId, leaderId])
  @@index([ruleId])
  @@index([status, occurredAt])
  @@index([category, direction])
}

model Evidence {
  id          String              @id @default(cuid())
  relatedType EvidenceRelatedType
  relatedId   String
  fileUrl     String              @db.Text
  fileType    String?
  description String?             @db.Text
  uploadedBy  String
  createdAt   DateTime            @default(now())

  @@index([relatedType, relatedId])
}

model SocialPost {
  id                  String           @id @default(cuid())
  applicationId       String           @unique
  application         ScoreApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  leaderId            String
  leader              Leader           @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  tripId              String
  trip                Trip             @relation(fields: [tripId], references: [id], onDelete: Restrict)
  platform            SocialPlatform
  postUrl             String?          @db.Text
  screenshotUrl       String?          @db.Text
  postedAt            DateTime
  isPublic            Boolean          @default(false)
  keep7DaysConfirmed  Boolean          @default(false)
  hasRealContent      Boolean          @default(false)
  hasBrandOrRouteInfo Boolean          @default(false)
  hasPortrait         Boolean          @default(false)
  portraitConfirmed   Boolean          @default(false)
  status              SocialPostStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([leaderId, tripId, platform])
  @@index([status, postedAt])
}

model RepurchaseClaim {
  id                     String                @id @default(cuid())
  applicationId          String                @unique
  application            ScoreApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  leaderId               String
  leader                 Leader                @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  oldCustomerName        String
  oldCustomerPhoneSuffix String?
  orderNo                String
  tripId                 String?
  trip                   Trip?                 @relation(fields: [tripId], references: [id], onDelete: SetNull)
  inviteTime             DateTime
  paymentTime            DateTime
  completedTrip          Boolean               @default(false)
  chatEvidenceUrl        String?               @db.Text
  status                 RepurchaseClaimStatus @default(PENDING)
  rejectReason           String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([orderNo])
  @@index([leaderId, status])
}

model HolidayAttendance {
  id                           String      @id @default(cuid())
  scoreYearId                  String
  scoreYear                    ScoreYear   @relation(fields: [scoreYearId], references: [id], onDelete: Restrict)
  leaderId                     String
  leader                       Leader      @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  holidayType                  HolidayType
  submittedAvailable           Boolean     @default(false)
  actuallyAssigned             Boolean     @default(false)
  actuallyCompleted            Boolean     @default(false)
  companyNotAssignedRecognized Boolean     @default(false)
  recognitionReason            String?     @db.Text
  approvedBy                   String?
  points                       Float       @default(0)
  countsForDoubleBonus         Boolean     @default(false)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  @@unique([scoreYearId, leaderId, holidayType])
  @@index([leaderId, countsForDoubleBonus])
}

model BonusPool {
  id          String    @id @default(cuid())
  scoreYearId String
  scoreYear   ScoreYear @relation(fields: [scoreYearId], references: [id], onDelete: Restrict)
  month       String?
  amount      Float
  sourceType  String?
  title       String    @default("奖金池注入")
  description String?   @db.Text
  injectedAt  DateTime  @default(now())
  createdBy   String?
  remark      String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([scoreYearId, injectedAt])
}

model BonusSettlement {
  id                    String                @id @default(cuid())
  scoreYearId           String
  scoreYear             ScoreYear             @relation(fields: [scoreYearId], references: [id], onDelete: Restrict)
  title                 String
  totalPoolAmount       Float
  eligibleLeaderCount   Int
  totalEligiblePoints   Float
  totalCalculatedAmount Float
  totalFinalAmount      Float
  totalCappedAmount     Float
  undistributedAmount   Float
  status                BonusSettlementStatus @default(DRAFT)
  remark                String?               @db.Text
  createdBy             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  items                 BonusSettlementItem[]
  leader                Leader?               @relation(fields: [leaderId], references: [id])
  leaderId              String?

  @@index([scoreYearId, createdAt])
  @@index([status])
}

model BonusSettlementItem {
  id                String          @id @default(cuid())
  settlementId      String
  settlement        BonusSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  leaderId          String
  leader            Leader          @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  rank              Int
  totalPoints       Float
  baseTripPoints    Float?
  applicationPoints Float?
  deductPoints      Float?
  tripCount         Int
  tripDays          Float
  eligible          Boolean
  ineligibleReason  String?         @db.Text
  pointShare        Float
  calculatedAmount  Float
  cappedAmount      Float
  finalAmount       Float
  createdAt         DateTime        @default(now())

  @@index([settlementId, rank])
  @@index([leaderId])
}

model ViolationEvent {
  id              String            @id @default(cuid())
  scoreYearId     String
  scoreYear       ScoreYear         @relation(fields: [scoreYearId], references: [id], onDelete: Restrict)
  leaderId        String
  leader          Leader            @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  tripId          String?
  trip            Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  ruleId          String?
  rule            ScoreRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleCode        String            @default("")
  type            ViolationType
  severity        ViolationSeverity
  title           String            @default("违规事件")
  description     String            @db.Text
  evidenceText    String?           @db.Text
  evidenceUrl     String?           @db.Text
  remark          String?           @db.Text
  points          Float
  scoreRecordId   String?
  disqualifyBonus Boolean           @default(false)
  clearPoints     Boolean           @default(false)
  status          ViolationStatus   @default(DRAFT)
  createdBy       String
  handledBy       String?
  approvedBy      String?
  occurredAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  handledAt       DateTime?
  approvedAt      DateTime?
  scoreRecords    ScoreRecord[]

  @@index([scoreYearId, leaderId])
  @@index([status, type, severity])
  @@index([ruleId])
  @@index([ruleCode])
  @@index([occurredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  beforeJson String?  @db.Text
  afterJson  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetType, targetId])
}
